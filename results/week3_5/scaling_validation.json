        100,
        2000
      ],
      "n_fold": 20.0,
      "affected_fold": 18.273,
      "oracle_runtime_fold": 75.527,
      "cow_runtime_fold": 37.74,
      "cow_evals_track_affected": true,
      "cow_materialization_tracks_affected": true
    },
    "when_expensive": {
      "exact_replay": "Costly whenever N is large and structural evaluations are expensive (LLM/tool-like), because both evals and materialization are O(N).",
      "dense_interventions": "As descendant ratio \u2192 1 (here 1.0), COW converges to Exact Replay cost; optimizations matter less."
    },
    "when_optimizations_matter": {
      "sparse_interventions": "At \u224810% affected (ratio=0.1002, N=500), median wall-clock speedup \u22489.785\u00d7 by restricting both structural evaluation and materialization to the affected subgraph.",
      "claim_template": "Under sparse interventions (\u224810% affected descendants), Copy-on-Write replay achieves approximately 9.785\u00d7 wall-clock speedup by restricting both structural evaluation and graph materialization to the affected subgraph. As the affected ratio approaches one, replay converges to Exact Replay, as expected."
    },
    "complexity_table": {
      "Exact Replay": {
        "structural_evals": "O(N)",
        "materialization": "O(N)"
      },
      "Descendant (pre-COW)": {
        "structural_evals": "O(|affected|)",
        "materialization": "O(N)"
      },
      "Descendant (COW)": {
        "structural_evals": "O(|affected|)",
        "materialization": "O(|affected|)"
      }
    }
